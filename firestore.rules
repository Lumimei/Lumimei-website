rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // 1. products 商品集合：公开只读，写入需管理员或认证用户
    match /products/{productId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // 2. users 用户集合：
    // 支持用户读取、注册与更新资料，更新本人(uid)或管理员
    match /users/{userId} {
      allow read: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if request.auth != null && (request.auth.uid == userId || request.auth.token.role == 'admin');
    }

    // 3. orders 订单集合：允许创建订单与读取
    match /orders/{orderId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if request.auth != null;
    }

    // 4. task_submissions 与 submissions 任务提交记录
    match /task_submissions/{subId} {
      allow read, write: if true;
    }
    match /submissions/{subId} {
      allow read, write: if true;
    }
    match /quiz_submissions/{subId} {
      allow read, write: if true;
    }

    // 5. expenses 支出管理记录
    match /expenses/{expenseId} {
      allow read, write: if true;
    }

    // 6. 其它集合默认允许已认证用户读写
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}

